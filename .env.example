# =============================================================================
# AegisCore AI — Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit .env to version control. Secrets are never logged.
# =============================================================================

# --- Application ---
APP_NAME=AegisCore AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security ---
# SECRET_KEY: used for JWT signing. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-secret-for-local-development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Encryption (AES-256-GCM for Gmail OAuth tokens at rest) ---
# ENCRYPTION_KEY: 32-byte base64-encoded key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-32-byte-base64-key

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/aegis_db
DATABASE_ECHO=false

# --- Redis (broker / cache / rate limit) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- ChromaDB (vectors) ---
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Ollama (local LLM / embeddings) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=phi3.5:3.8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:7b

# --- Cloud AI API (public inference fallback) ---
# Default candidate: Gemini. BLOCKED until a verified free-tier key exists.
CLOUD_AI_PROVIDER=gemini
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CLOUD_AI_MODEL=gemini-1.5-flash

# --- Gmail OAuth2 (per-user, draft-only mode works without credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.send
GMAIL_CONSENT_TYPE=internal   # internal | external (external requires Google app review)

# --- File storage ---
UPLOAD_MAX_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# --- Quotas (adjustable; free-tier limits unverified) ---
MAX_DOCS_PER_USER=100
MAX_UPLOAD_SIZE_MB=50
MAX_EMAIL_SENDS_PER_DAY=10
MAX_AI_TOKENS_PER_DAY=1000

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Feature flags ---
ENABLE_VISION_LOCAL=false      # blocked on 8 GB RAM; vision runs via cloud path
ENABLE_DRAFT_ONLY_MODE=true
ENABLE_PUBLIC_INFERENCE=false  # BLOCKED until verified free-tier key
